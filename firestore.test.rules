rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function childPath(childId) {
      return /databases/$(database)/documents/children/$(childId);
    }

    function childExists(childId) {
      return exists(childPath(childId));
    }

    function childData(childId) {
      return get(childPath(childId)).data;
    }

    function isParent(childId) {
      return signedIn()
        && childExists(childId)
        && childData(childId).parentIds is list
        && request.auth.uid in childData(childId).parentIds;
    }

    function isLinked(child) {
      return child.status == 'vinculado'
        && child.deviceUid is string
        && child.deviceUid.size() > 0;
    }

    function isDevice(childId) {
      return signedIn()
        && childExists(childId)
        && isLinked(childData(childId))
        && childData(childId).deviceUid == request.auth.uid;
    }

    function consentAllows(parentId, child, purpose) {
      let consentPath =
        /databases/$(database)/documents/users/$(parentId)/privacy_consents/current;

      return exists(consentPath)
        && get(consentPath).data.status in ['active', 'partially_revoked']
        && get(consentPath).data.termsVersion == child.privacyAuthorization.termsVersion
        && get(consentPath).data.privacyVersion == child.privacyAuthorization.privacyVersion
        && get(consentPath).data.acceptTerms == true
        && get(consentPath).data.acknowledgePrivacy == true
        && get(consentPath).data.guardianDeclaration == true
        && (
          !('revocationPending' in get(consentPath).data)
          || get(consentPath).data.revocationPending == false
        )
        && get(consentPath).data.purposes[purpose] == true;
    }

    function allGuardiansAllow(child, purpose) {
      return child.parentIds is list
        && child.parentIds.size() >= 1
        && child.parentIds.size() <= 2
        && consentAllows(child.parentIds[0], child, purpose)
        && (
          child.parentIds.size() == 1
          || consentAllows(child.parentIds[1], child, purpose)
        );
    }

    function purposeAllowed(childId, purpose) {
      let child = childData(childId);

      return childExists(childId)
        && isLinked(child)
        && child.privacyAuthorization.purposes[purpose] == true
        && allGuardiansAllow(child, purpose);
    }

    function parentCan(childId, purpose) {
      return isParent(childId) && purposeAllowed(childId, purpose);
    }

    function deviceCan(childId, purpose) {
      return isDevice(childId) && purposeAllowed(childId, purpose);
    }

    function validSchedule(schedule) {
      return schedule is map
        && schedule.keys().hasOnly(['days', 'start', 'end'])
        && schedule.days is list
        && schedule.days.size() >= 1
        && schedule.days.size() <= 7
        && schedule.start is string
        && schedule.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && schedule.end is string
        && schedule.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function controlPurpose(controlId) {
      return controlId == 'web_protection' ? 'domain_filtering' : 'app_filtering';
    }

    function stampedByMe(data) {
      return data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validControl(controlId, data) {
      return (controlId == 'study_mode' && validStudyMode(data))
        || (controlId == 'app_limits' && validAppLimits(data))
        || (controlId == 'web_protection' && validWebProtection(data));
    }

    function validAppLimits(data) {
      return data.keys().hasOnly(['limits', 'updatedAt', 'updatedBy'])
        && data.limits is map
        && data.limits.size() <= 100
        && stampedByMe(data);
    }

    function validWebProtection(data) {
      return data.keys().hasOnly(['safeSearch', 'blockDoh', 'updatedAt', 'updatedBy'])
        && data.safeSearch is bool
        && data.blockDoh is bool
        && stampedByMe(data);
    }

    function validZone(data) {
      return data.keys().hasOnly([
          'name', 'lat', 'lng', 'radius', 'notifyEnter', 'notifyExit',
          'updatedAt', 'updatedBy'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.radius is number && data.radius >= 50 && data.radius <= 5000
        && data.notifyEnter is bool
        && data.notifyExit is bool
        && stampedByMe(data);
    }

    function validNewRequest(data) {
      return data.keys().hasOnly([
          'type', 'packageName', 'appName', 'minutes', 'message',
          'status', 'createdAt'
        ])
        && data.type in ['unlock_app', 'extra_time']
        && data.packageName is string
        && data.packageName.size() >= 1 && data.packageName.size() <= 200
        && data.appName is string && data.appName.size() <= 100
        && data.minutes is int && data.minutes >= 5 && data.minutes <= 240
        && (!('message' in data) || (data.message is string && data.message.size() <= 200))
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function validResolution(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'status', 'resolvedAt', 'resolvedBy', 'grantedMinutes', 'approvedUntil'
        ])
        && data.status in ['approved', 'denied']
        && data.resolvedBy == request.auth.uid
        && data.resolvedAt == request.time
        && (
          data.status == 'denied'
          || (
            data.grantedMinutes is int
            && data.grantedMinutes >= 5 && data.grantedMinutes <= 240
            && data.approvedUntil is timestamp
            && data.approvedUntil > request.time
            && data.approvedUntil <= request.time + duration.value(241, 'm')
          )
        );
    }

    function validStudyMode(data) {
      return data.keys().hasOnly([
          'active', 'endsAt', 'allowedApps', 'schedules',
          'updatedAt', 'updatedBy'
        ])
        && data.active is bool
        && (!('endsAt' in data) || data.endsAt == null || data.endsAt is timestamp)
        && data.allowedApps is list
        && data.allowedApps.size() <= 100
        && data.schedules is list
        && data.schedules.size() <= 7
        && (data.schedules.size() < 1 || validSchedule(data.schedules[0]))
        && (data.schedules.size() < 2 || validSchedule(data.schedules[1]))
        && (data.schedules.size() < 3 || validSchedule(data.schedules[2]))
        && (data.schedules.size() < 4 || validSchedule(data.schedules[3]))
        && (data.schedules.size() < 5 || validSchedule(data.schedules[4]))
        && (data.schedules.size() < 6 || validSchedule(data.schedules[5]))
        && (data.schedules.size() < 7 || validSchedule(data.schedules[6]))
        && stampedByMe(data);
    }

    function filterPurpose(category) {
      return category == 'app' ? 'app_filtering' : 'domain_filtering';
    }

    match /users/{uid} {
      allow read, create, update: if signedIn()
        && request.auth.uid == uid;
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == uid;
      }

      match /privacy_consents/{documentId} {
        allow read, write: if false;
      }

      match /privacy_events/{eventId} {
        allow read, write: if false;
      }
    }

    match /children/{childId} {
      // resource.data is used (not get()) so it also works in queries:
      // "children where parentIds contains my uid". Firestore only allows the
      // query if its filter guarantees this condition.
      allow read: if signedIn()
        && request.auth.uid in resource.data.parentIds;
      allow create, update, delete: if false;

      match /alerts/{alertId} {
        allow read, delete: if parentCan(childId, 'alerts');
        allow create: if deviceCan(childId, 'alerts');
        allow update: if false;
      }

      match /device_status/{documentId} {
        allow read: if parentCan(childId, 'device_status');
        allow create, update: if deviceCan(childId, 'device_status');
        allow delete: if false;
      }

      match /usage_reports/{reportId} {
        allow read: if parentCan(childId, 'usage_stats');
        allow create, update: if deviceCan(childId, 'usage_stats');
        allow delete: if false;
      }

      match /installed_apps/{appId} {
        // The device also reads its catalogue to sync changes.
        allow read: if parentCan(childId, 'app_filtering')
          || deviceCan(childId, 'app_filtering');
        allow create, update, delete: if deviceCan(childId, 'app_filtering');
      }

      match /filter_rules/{ruleId} {
        allow read: if (
          isParent(childId)
          && resource.data.category in ['app', 'url']
          && parentCan(childId, filterPurpose(resource.data.category))
        ) || (
          isDevice(childId)
          && resource.data.category in ['app', 'url']
          && deviceCan(childId, filterPurpose(resource.data.category))
        );

        allow create: if isParent(childId)
          && request.resource.data.category in ['app', 'url']
          && parentCan(childId, filterPurpose(request.resource.data.category));

        allow update: if isParent(childId)
          && resource.data.category in ['app', 'url']
          && request.resource.data.category == resource.data.category
          && parentCan(childId, filterPurpose(resource.data.category));

        allow delete: if isParent(childId)
          && resource.data.category in ['app', 'url']
          && parentCan(childId, filterPurpose(resource.data.category));
      }

      match /reportes/{documentId} {
        allow read, write: if false;
      }

      // Controls set by the guardian and applied on the device.
      //   study_mode, app_limits -> app_filtering purpose
      //   web_protection         -> domain_filtering purpose
      match /controls/{controlId} {
        allow read: if controlId in ['study_mode', 'app_limits', 'web_protection'] && (
          parentCan(childId, controlPurpose(controlId))
          || deviceCan(childId, controlPurpose(controlId))
        );

        allow create, update: if controlId in ['study_mode', 'app_limits', 'web_protection']
          && parentCan(childId, controlPurpose(controlId))
          && validControl(controlId, request.resource.data);

        allow delete: if controlId in ['study_mode', 'app_limits', 'web_protection']
          && parentCan(childId, controlPurpose(controlId));
      }

      // Safe zones (geofences). The guardian creates them; the device
      // uses them to report arrivals and departures.
      match /zones/{zoneId} {
        allow read: if parentCan(childId, 'location')
          || deviceCan(childId, 'location');
        allow create, update: if parentCan(childId, 'location')
          && validZone(request.resource.data);
        allow delete: if parentCan(childId, 'location');
      }

      // Requests from the minor ("more time", "unlock app").
      match /requests/{requestId} {
        allow read: if parentCan(childId, 'app_filtering')
          || deviceCan(childId, 'app_filtering');

        allow create: if deviceCan(childId, 'app_filtering')
          && validNewRequest(request.resource.data);

        // The guardian can only resolve a pending request.
        allow update: if parentCan(childId, 'app_filtering')
          && resource.data.status == 'pending'
          && validResolution(request.resource.data);

        allow delete: if parentCan(childId, 'app_filtering');
      }

      // Weekly summaries: generated by the server.
      match /weekly_summaries/{weekId} {
        allow read: if parentCan(childId, 'alerts');
        allow write: if false;
      }
    }

    match /telemetria/{childId} {
      allow read: if parentCan(childId, 'location')
        || deviceCan(childId, 'location');

      allow create, update: if deviceCan(childId, 'location');
      allow delete: if false;

      match /historial/{entryId} {
        allow read: if parentCan(childId, 'location')
          || deviceCan(childId, 'location');

        allow create: if deviceCan(childId, 'location');
        allow update, delete: if false;
      }
    }

    match /pairing_codes/{documentId} {
      allow read, write: if false;
    }

    match /devices/{deviceId} {
      allow read, write: if false;
    }

    match /configuraciones/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
